{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "reinfeld/quotation",
  "title": "RFZitat",
  "category": "text",
  "icon": "format-quote",
  "description": "Zitat mit optionaler Quellenangabe.",
  "textdomain": "reinfeld",
  "attributes": {
    "quote": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
