{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "reinfeld/wortwolke",
  "title": "RFWortwolke",
  "category": "widgets",
  "icon": "tag",
  "description": "Wortwolke der Schlagwörter oder einer Taxonomie, häufige Begriffe größer.",
  "textdomain": "reinfeld",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "taxonomy": {
      "type": "string",
      "default": "post_tag"
    },
    "threshold": {
      "type": "number",
      "default": 5
    },
    "minFontSize": {
      "type": "number",
      "default": 10
    },
    "maxFontSize": {
      "type": "number",
      "default": 30
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
